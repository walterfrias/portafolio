---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Walter Frias — Product Engineer",
  description = "Product Engineer with 10+ years running operations. I find real business problems and build the software that solves them — full stack, with applied AI, running in production.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-950 text-white antialiased">
    <div class="lg:flex min-h-screen max-w-screen-xl mx-auto">

      <aside class="lg:w-5/12 lg:sticky lg:top-0 lg:h-screen lg:overflow-y-auto px-8 pt-16 pb-8 lg:px-16 lg:py-24">
        <slot name="sidebar" />
      </aside>

      <main class="lg:w-7/12 px-8 lg:px-16 py-16 lg:py-24">
        <slot />
        <Footer />
      </main>

    </div>
  </body>
</html>
