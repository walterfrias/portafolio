---
import { projects } from '../data/projects';
---

<section id="projects" class="py-20">
  <h2 class="text-xs font-semibold tracking-widest uppercase text-amber-400 mb-10">
    Selected Projects
  </h2>

  <div class="flex flex-col gap-6">
    {projects.map((project) => (
      <div class="group relative rounded-xl border border-slate-800 hover:border-slate-600 active:scale-[0.98] active:border-amber-300/30 transition-all duration-300 overflow-hidden h-96">

        {project.image ? (
          <img
            src={project.image.src}
            alt={project.name}
            class={`w-full h-full group-hover:scale-105 transition-transform duration-500 object-cover ${project.contain ? 'object-center' : project.objectPosition ?? 'object-top'}`}
          />
        ) : (
          <div aria-hidden="true" class="w-full h-full bg-gradient-to-br from-slate-900 via-slate-900 to-amber-950/50 p-8">
            <span class="text-4xl font-bold text-slate-700 group-hover:text-slate-600 transition-colors duration-500" style="font-family: 'Sora', sans-serif;">
              {project.name.split(' — ')[0]}
            </span>
          </div>
        )}

        <div class="absolute bottom-0 left-0 right-0 p-5 bg-slate-950/85 group-hover:bg-slate-950/30 backdrop-blur-sm group-hover:backdrop-blur-none transition-all duration-500">
          <div class="flex items-start justify-between gap-4 mb-2">
            <h3 class="text-white font-semibold text-base leading-snug">
              {project.url ? (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-amber-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 rounded-sm transition-colors inline-flex items-center gap-2"
                >
                  {project.name}
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
              ) : (
                project.name
              )}
            </h3>

            <div class="flex items-center gap-2 shrink-0">
              {project.badge && (
                <span class="text-xs font-semibold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-2 py-1 rounded-full">
                  {project.badge}
                </span>
              )}
              {project.devpost && (
                <a
                  href={project.devpost}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-slate-400 border border-slate-700 hover:border-slate-500 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 px-3 py-3 rounded-full transition-colors duration-200"
                >
                  Devpost ↗
                </a>
              )}
            </div>
          </div>

          <p class="text-slate-300 text-sm leading-relaxed mb-3 line-clamp-3">
            {project.description}
          </p>

          <div class="flex items-center justify-between gap-2 mt-3">
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="text-xs text-slate-300 bg-slate-800/60 px-2 py-1 rounded-md">
                  {tag}
                </span>
              ))}
            </div>
            {project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="md:hidden shrink-0 text-xs font-medium text-amber-300 border border-amber-300/30 hover:border-amber-300/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 px-4 py-3 rounded-full transition-colors duration-200 whitespace-nowrap"
              >
                Visit ↗
              </a>
            )}
          </div>
        </div>

      </div>
    ))}
  </div>
</section>
